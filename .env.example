APP_NAME=Plant Reminder API
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Host run + Dockerized PostgreSQL (docker-compose.postgres.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plant_reminder
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
OPENROUTER_API_KEY=
PROXY_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_VISION_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Plant Reminder API

# Image storage. Use local only for development without Cloudflare.
MEDIA_STORAGE_BACKEND=r2
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_KEY_PREFIX=uploads
# Optional Worker-proxy mode. If omitted, backend uploads directly through R2's S3-compatible API.
R2_WORKER_UPLOAD_URL=
R2_WORKER_SHARED_SECRET=
# Direct R2 mode.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=r2-first-bucket

# RevenueCat Integration
REVENUECAT_WEBHOOK_AUTH_HEADER=replace-with-webhook-auth-header-secret
REVENUECAT_REST_API_KEY=replace-with-rest-api-key-secret
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_PRO_ENTITLEMENT_ID=PlantReminder Pro

