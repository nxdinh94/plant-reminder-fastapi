APP_NAME=Plant Reminder API
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Host run + Dockerized PostgreSQL (docker-compose.postgres.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plant_reminder
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Plant Reminder API
